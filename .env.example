# Frontend BFF. Use the same secret as LEARNY_BFF_SECRET in backend/.env.
LEARNY_API_URL=http://localhost:8080
LEARNY_BFF_SECRET=replace-with-a-long-random-secret

# Local development identity. Never use these as production authorization.
LEARNY_DEV_USER_ID=local-londxz
LEARNY_DEV_USER_EMAIL=you@example.com

